<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="shopping_list.MainPage">

    <ScrollView>
        <Grid RowDefinitions="auto,*" ColumnDefinitions="*,*">
            
            <Entry Grid.Row="0" Grid.Column="0" TextColor="Black"></Entry>
            <Button Text="Submit" Grid.Row="0" Grid.Column="1"></Button>

            <CollectionView ItemsSource="{Binding Products}" x:Name="productsCollectionView">
                
            </CollectionView>

            
        </Grid>
    </ScrollView>

</ContentPage>
